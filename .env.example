# Copy to .env.local and fill in.

# Required — Claude chat + user-model document
ANTHROPIC_API_KEY=sk-ant-...

# Required for voice (Phases 2-3) — ElevenLabs TTS + instant voice cloning
# (Starter plan or above is needed for cloning)
ELEVENLABS_API_KEY=...
# Optional: stock voice used before your clone is ready (default: Rachel)
ELEVENLABS_STOCK_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional — server-side speech-to-text fallback for browsers without the
# Web Speech API (push-to-talk). Chrome users don't need this.
DEEPGRAM_API_KEY=...
